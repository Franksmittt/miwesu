# =============================================================================
# MIWESU Backend & Email – Environment Variables
# Copy to .env and fill in. For production, set the same in Vercel → Settings → Environment Variables.
# =============================================================================

# --- Public URLs (SEO, sitemap, OG) ---
NEXT_PUBLIC_BASE_URL="https://www.miwesu.co.za"
NEXT_PUBLIC_APP_URL="https://www.miwesu.co.za"

# --- Database (Supabase or other PostgreSQL) ---
# Supabase: use pooler (6543, pgbouncer=true) for app; direct (5432) for migrations.
# Replace [YOUR-PASSWORD] with Database password from Supabase → Project Settings → Database.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Admin portal (owner login) ---
# Single password for /admin. Use a strong password in production.
ADMIN_PASSWORD="your-secure-password"

# --- Session signing (recommended for production) ---
# High-entropy secret for signing admin session cookie. If unset, ADMIN_PASSWORD is used.
# Generate: openssl rand -base64 32
# SESSION_SECRET="..."

# --- Resend (all outgoing email) ---
# Get API key: https://resend.com → API Keys. Domain must be verified to send from your address.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# From address for all outgoing mail. Must be on a domain verified in Resend (e.g. bookings@miwesu.co.za).
MIWESU_BOOKING_FROM_EMAIL="bookings@miwesu.co.za"

# Where booking enquiry notifications are sent
MIWESU_ADMIN_EMAIL="info@miwesu.co.za"
MIWESU_ADMIN_CC="admin@miwesu.co.za,bookings@miwesu.co.za"

# Contact form destination
MIWESU_CONTACT_TO="info@miwesu.co.za"
MIWESU_CONTACT_CC="admin@miwesu.co.za,bookings@miwesu.co.za"

# Wood orders / other forms (if used)
WOOD_ORDER_EMAIL="info@miwesu.co.za"

# --- Stripe (optional; not used in current enquiry-only flow) ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
