# Required for production: canonical URLs, sitemap, OG links
NEXT_PUBLIC_BASE_URL="https://www.miwesu.com"
NEXT_PUBLIC_APP_URL="https://www.miwesu.com"

# Database (Phase 1) - PostgreSQL e.g. Supabase or Vercel Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Stripe (Phase 4) - optional until payment integration
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# Admin portal (owner login to view enquiries, confirm bookings, email clients)
ADMIN_PASSWORD=your-secure-password

# Resend – get API key from https://resend.com (verify miwesu.co.za to send)
# RESEND_API_KEY=re_...

# Central inbox for Wayne & Melissa: info@ gets enquiries + booking alerts; admin@ & bookings@ get CC
MIWESU_BOOKING_FROM_EMAIL=bookings@miwesu.co.za
MIWESU_ADMIN_EMAIL=info@miwesu.co.za
MIWESU_ADMIN_CC=admin@miwesu.co.za,bookings@miwesu.co.za
MIWESU_CONTACT_TO=info@miwesu.co.za
MIWESU_CONTACT_CC=admin@miwesu.co.za,bookings@miwesu.co.za
WOOD_ORDER_EMAIL=info@miwesu.co.za
